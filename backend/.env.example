DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=usv
DATABASE_USER=usv_app
DATABASE_PASSWORD=change-me
APP_ENV=development

AUTH_SECRET_KEY=change-me
AUTH_TOKEN_EXPIRY_MINUTES=30

APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Tribot External Data API (OT Asset -> Tribot). Issue a credential from
# Tribot's own Integration admin page, then set the base URL its instance is
# reachable at (not this USV backend's own host/port) and the issued
# "<credential_id>.<secret>" token here.
TRIBOT_BASE_URL=http://127.0.0.1:8010
TRIBOT_API_TOKEN=
